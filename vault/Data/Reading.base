filters:
  and:
    - 'file.ext == "md"'
    - 'file.inFolder("Library/Books")'
    - 'category == "book"'
    - 'collection == this.file.properties.collection'
properties:
  file.name:
    displayName: Book
  note.author:
    displayName: Author
  note.status:
    displayName: Reading status
  note.rating:
    displayName: Revisit / 5
  note.year:
    displayName: Published
views:
  - type: table
    name: The annotated shelf
    order:
      - file.name
      - note.author
      - note.status
      - note.rating
      - note.year
    sort:
      - property: note.rating
        direction: DESC
      - property: file.name
        direction: ASC
