filters:
  and:
    - 'file.ext == "md"'
    - 'file.inFolder("Field Notes")'
    - 'category == this.file.properties["related-category"]'
    - 'file.path != this.file.path'
properties:
  file.name:
    displayName: Nearby note
  note.status:
    displayName: Growth
  note.date:
    displayName: Last tended
  note.tags:
    displayName: Threads
views:
  - type: table
    name: Nearby field notes
    order:
      - file.name
      - note.status
      - note.date
      - note.tags
    sort:
      - property: note.date
        direction: DESC
